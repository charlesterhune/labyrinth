FROM python:3.12

RUN apt-get update && apt-get install -y \
    nginx \
    nodejs \
    npm \
    gcc \
    g++ \
    cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# Build Labyrinth frontend
WORKDIR /app/web-client
RUN npm ci
RUN npm run build

# Install backend
WORKDIR /app
RUN pip install --no-cache-dir uwsgi
RUN pip install --no-cache-dir -r backend/requirements.txt

# Build solver libraries
WORKDIR /app/algolibs
RUN mkdir -p build
RUN cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=RELEASE \
    -DBUILD_TESTS=OFF \
    -DBUILD_BENCHMARKS=OFF
RUN cmake --build build

# Prepare backend
WORKDIR /app
RUN rm -rf backend/instance/lib
RUN mkdir -p backend/instance/lib
RUN cp algolibs/build/solvers/*.so backend/instance/lib/
RUN python backend/instance/create_secret.py >> backend/instance/config.py

# Install the built Labyrinth frontend
RUN rm -rf /usr/share/nginx/html/*
RUN cp -r /app/web-client/dist/. /usr/share/nginx/html/

# REMOVE Debian's default nginx configuration
RUN rm -f /etc/nginx/sites-enabled/default
RUN rm -f /etc/nginx/conf.d/default.conf

# Create the Render nginx configuration
RUN printf '%s\n' \
'server {' \
'    listen 10000 default_server;' \
'    listen [::]:10000 default_server;' \
'    server_name _;' \
'' \
'    root /usr/share/nginx/html;' \
'    index index.html;' \
'' \
'    location / {' \
'        try_files $uri $uri/ /index.html;' \
'    }' \
'' \
'    location /api/ {' \
'        proxy_pass http://127.0.0.1:9113;' \
'        proxy_http_version 1.1;' \
'        proxy_set_header Host $host;' \
'        proxy_set_header X-Real-IP $remote_addr;' \
'        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
'        proxy_set_header X-Forwarded-Proto $scheme;' \
'    }' \
'}' \
> /etc/nginx/conf.d/labyrinth.conf

EXPOSE 10000

CMD ["sh", "-c", "cd /app/backend && uwsgi --http 127.0.0.1:9113 --wsgi-file labyrinth_main.py --callable app & exec nginx -g 'daemon off;'"]