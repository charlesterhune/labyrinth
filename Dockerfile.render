##########################################################
# BUILD ALGOLIB SOLVER LIBRARIES
##########################################################
FROM gcc:15 AS algolibs-base

WORKDIR /usr/src/algolibs

RUN apt-get update && apt-get install -y \
    cmake \
    && rm -rf /var/lib/apt/lists/*

COPY algolibs/solvers ./solvers
COPY algolibs/CMakeLists.txt .

FROM algolibs-base AS algolibs-release

RUN mkdir build

RUN cmake -S. -Bbuild \
    -DCMAKE_BUILD_TYPE=RELEASE \
    -DBUILD_TESTS=OFF \
    -DBUILD_BENCHMARKS=OFF

RUN cmake --build build


##########################################################
# BUILD VUE FRONTEND
##########################################################
FROM node:18 AS frontend-build

WORKDIR /app/web-client

COPY web-client/package*.json ./

RUN npm ci

COPY web-client/ ./

RUN npm run build


##########################################################
# FINAL RENDER IMAGE
##########################################################
FROM python:3.12 AS release

WORKDIR /app


##########################################################
# SYSTEM DEPENDENCIES
##########################################################
RUN apt-get update && apt-get install -y \
    nginx \
    && rm -rf /var/lib/apt/lists/*


##########################################################
# BACKEND
##########################################################

# Copy backend source
COPY backend/labyrinth ./labyrinth
COPY backend/instance ./instance

# Solver libraries
RUN rm -rf instance/lib
RUN mkdir -p instance/lib

COPY --from=algolibs-release \
    /usr/src/algolibs/build/solvers/*.so \
    instance/lib/


##########################################################
# PYTHON RUNTIME DEPENDENCIES
##########################################################

# Give PyPI extra retries/time so temporary 502 errors
# do not kill the Render deployment.
RUN pip install \
    --no-cache-dir \
    --retries 10 \
    --timeout 60 \
    uwsgi

COPY backend/requirements.txt ./

RUN pip install \
    --no-cache-dir \
    --retries 10 \
    --timeout 60 \
    -r requirements.txt


##########################################################
# PRODUCTION BACKEND FILES
##########################################################
COPY backend/labyrinth_main.py ./
COPY backend/uwsgi-docker.ini ./

# Generate application secret
RUN python instance/create_secret.py >> instance/config.py


##########################################################
# FRONTEND
##########################################################
RUN rm -rf /usr/share/nginx/html/*

COPY --from=frontend-build \
    /app/web-client/dist/ \
    /usr/share/nginx/html/


##########################################################
# NGINX CONFIGURATION
##########################################################
RUN rm -f /etc/nginx/sites-enabled/default
RUN rm -f /etc/nginx/conf.d/default.conf

RUN printf '%s\n' \
'server {' \
'    listen 10000 default_server;' \
'    listen [::]:10000 default_server;' \
'    server_name _;' \
'' \
'    root /usr/share/nginx/html;' \
'    index index.html;' \
'' \
'    location = /index.html {' \
'        add_header Cache-Control "no-cache, no-store, must-revalidate" always;' \
'        add_header Pragma "no-cache" always;' \
'        add_header Expires "0" always;' \
'        try_files $uri =404;' \
'    }' \
'' \
'    location / {' \
'        add_header Cache-Control "no-cache" always;' \
'        try_files $uri $uri/ /index.html;' \
'    }' \
'' \
'    location /api/ {' \
'        proxy_pass http://127.0.0.1:9113;' \
'        proxy_http_version 1.1;' \
'        proxy_set_header Host $host;' \
'        proxy_set_header X-Real-IP $remote_addr;' \
'        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
'        proxy_set_header X-Forwarded-Proto $scheme;' \
'    }' \
'}' \
> /etc/nginx/conf.d/labyrinth.conf


##########################################################
# RUNTIME
##########################################################

# Backend talks to itself here
ENV INTERNAL_URL="http://127.0.0.1:9113"

# Render public port
EXPOSE 10000

# Start the original Labyrinth uWSGI configuration
# and keep nginx in the foreground.
CMD ["sh", "-c", "uwsgi uwsgi-docker.ini & exec nginx -g 'daemon off;'"]